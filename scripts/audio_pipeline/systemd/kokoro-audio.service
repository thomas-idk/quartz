# NOT installed. This is provided for when you're ready to schedule the
# pipeline; nothing here runs automatically just by this file existing in
# the repo.
#
# To install (as your own user, not root — it needs your git credentials
# and the repo checkout):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/audio_pipeline/systemd/kokoro-audio.* ~/.config/systemd/user/
#   # edit the WorkingDirectory= path below if this checkout isn't at
#   # /home/thomas/quartz
#   systemctl --user daemon-reload
#   systemctl --user enable --now kokoro-audio.timer
#
# CPUQuota=100% caps this at roughly one core regardless of how many threads
# the model runtime spawns underneath (belt-and-suspenders with the
# sched_setaffinity call render.py already does itself).

[Unit]
Description=Note narration pipeline (Kokoro)

[Service]
Type=oneshot
WorkingDirectory=/home/thomas/quartz
# Dependencies (kokoro, torch, mutagen, ...) live in the repo-local venv, not
# system Python. ffmpeg is a static binary in ~/.local/bin -- systemd user
# units don't inherit an interactive shell's PATH, so it's set explicitly.
Environment=PATH=/home/thomas/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/thomas/quartz/.venv/bin/python3 -m scripts.audio_pipeline.render
CPUQuota=100%
Nice=19
IOSchedulingClass=idle
